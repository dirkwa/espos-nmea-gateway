W/Њ‰|)__›ISш.Aћ1JЃ[AP%бчЛэђ#L¶ґл:MX®U–1LhЖ‚2zумісЛzХф	a9ЦѓTЋвИЅu…Q[7ґDWї4­}k2йhфвоnmг3ыиtіЦЙ‚жЌЧљQ¤Эм4ЇfО„<saюto2•~Ч#„]ЩїhLШnла‹ъ·ФщцkХЌ‰bЄіш»ЁQ§‰cьЇA'€LЈJ™gВЋ+“<Џ¦г‰ЊЯ}ъшн‘iш?э±␀aЭя␀␀␀␀т␀␀‹␀␀␀␀␀mQMK1ЅчWЊsо6zI„‚^Д[L¦fl6Y“йЦю{ЩЖТ‚ћf†чoф•ПN#Aђ!ц=€6}¤„э@І~^␀ф@bБ[*‰Бќlє[u	&;ђБ‰i?ж".'Ў$чм%O;кЋЗ8±°Ќ]u6’№щЧКеKW] Ѓ.м"oЛц¬–H=ХсщE«v4 rЪBЎhђ]NЎРЖ ·bп–gyu…GЃ№ѓCц»Hµ8ѓКЦJR'OЯЭЪ?|Ѕ>жaхY±ЧЄЙю$U9DЄЃHNy'—#Т­п»л·§°Y№Z[ПкTґ~Пюрkиyцн8Оaћ§Жm­ЪЫ~␀>sмЗ␀␀␀␀Фj@␀␀␀␀\њ@␀␀␀8З@␀␀␀Ф@␀␀␀Ф@␀␀␀Ф@␀␀␀ШЌ@4Ш@0Щ@”З@XЩ@<Ш@␀␀Ђ?␀␀zD␀␀Ђ␀␀АABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/␀␀␀␀12dd332f3c76f4fb␀␀␀␀П6␀␀{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:espos:config","title":"espOS configuration","description":"Every property is an NVS namespace; every nested property is a key in it. Values omitted from a PUT are left untouched; null resets a key to its default; secret values read back as \"********\" and that sentinel is ignored on write.","type":"object","properties":{"can":{"type":"object","title":"NMEA 2000 bus","x-espos-version":1,"properties":{"tx_pin":{"title":"CAN TX pin","description":"GPIO wired to the transceiver's TXD (CTX on most modules).","type":"integer","default":-1,"minimum":-1,"maximum":63,"x-espos-restartRequired":true},"rx_pin":{"title":"CAN RX pin","description":"GPIO wired to the transceiver's RXD (CRX on most modules).","type":"integer","default":-1,"minimum":-1,"maximum":63,"x-espos-restartRequired":true},"transmit":{"title":"Send to the bus","description":"Write frames that signalk-server sends onto the bus. Off makes the gateway receive only, for a boat where nothing should ever originate frames from this device.","type":"boolean","default":true,"x-espos-restartRequired":true}},"additionalProperties":false,"description":"The pins the CAN transceiver is wired to. -1 uses this firmware's default for the chip, which the README lists per board. A pin that cannot carry CAN on this chip leaves the bus stopped and says why in the log."},"httpd":{"type":"object","title":"HTTP server","x-espos-version":2,"properties":{"port":{"title":"TCP port","description":"Port the HTTP server listens on.","type":"integer","default":80,"minimum":1,"maximum":65535,"x-espos-restartRequired":true},"api_key":{"title":"API key","description":"Shared secret for the web UI and the REST API, sent as Authorization: Bearer or exchanged for a login cookie. Empty = no authentication, the API is open to anyone on the network. 8вЂ“64 characters; the Config page can generate one. Changing it logs every browser out.","type":"string","default":"","maxLength":64,"writeOnly":true,"format":"password","x-espos-secret":true},"session_ttl_s":{"title":"Login session lifetime","description":"How long a browser login (the espos_sid cookie) stays valid. Sessions live in RAM; a reboot ends them all.","type":"integer","default":86400,"minimum":60,"maximum":2592000,"x-espos-unit":"s"}},"additionalProperties":false,"description":"Built-in web server serving the UI and the REST API."},"net":{"type":"object","title":"Network","x-espos-version":1,"properties":{"hostname":{"title":"Hostname","description":"DHCP and mDNS name (<hostname>.local); also the SignalK source label and the name in the server's access-request list. Empty = espos-<last 4 hex of the device MAC>.","type":"string","default":"","maxLength":32,"pattern":"^[A-Za-z0-9-]*$","x-espos-restartRequired":true}},"additionalProperties":false,"description":"What the device is called on the network, whichever interface carries it."},"ota":{"type":"object","title":"Firmware updates","x-espos-version":1,"properties":{"manifest_src":{"title":"Where to look for updates","description":"url = the manifest URL below. signalk = ask the SignalK server this device is already connected to, so a device that finds its server also finds its updates and nothing has to be typed per device (needs a fleet-update plugin on that server).","type":"string","default":"url","maxLength":7,"enum":["url","signalk"]},"manifest_url":{"title":"Manifest URL","description":"http(s) URL of a version manifest (docs/ota.md). Empty = manual updates from a URL only. Ignored when the source above is signalk.","type":"string","default":"","maxLength":160},"manifest_path":{"title":"Manifest path on the server","description":"Path appended to the SignalK server's address when the source is signalk. The default is where the fleet-update plugin serves it.","type":"string","default":"/plugins/signalk-espos-updates/manifest.json","maxLength":120},"channel":{"title":"Channel","description":"Which channel of the manifest to follow, e.g. stable or beta.","type":"string","default":"stable","maxLength":15},"auto_check":{"title":"Check automatically","description":"Fetch the manifest after boot and every check interval.","type":"boolean","default":true},"check_h":{"title":"Check interval","type":"integer","default":24,"minimum":1,"maximum":168,"x-espos-unit":"h"},"auto_install":{"title":"Install automatically","description":"Install a newer build from the manifest as soon as it is found (device reboots). Off = only show it.","type":"boolean","default":false},"allow_insecure":{"title":"Skip TLS certificate check","description":"Accept any https certificate (self-signed boat servers). Images are still signature-checked.","type":"boolean","default":false},"confirm_tmo_s":{"title":"Rollback timeout","description":"A freshly installed image must reach the network within this time, else the device rolls back to the previous firmware.","type":"integer","default":600,"minimum":30,"maximum":3600,"x-espos-unit":"s"}},"additionalProperties":false,"description":"Over-the-air updates: where to look for new firmware and how careful to be about a freshly installed image."},"time":{"type":"object","title":"Clock","x-espos-version":1,"properties":{"sntp":{"title":"Set the clock from NTP","description":"Ask an NTP server for the time once the network is up. Off = the clock comes only from the SignalK stream or a manual set, which is what a device on a boat network with no internet route wants.","type":"boolean","default":true,"x-espos-restartRequired":true},"server0":{"title":"NTP server","description":"Host name or IP. Empty and with DHCP off, nothing is asked.","type":"string","default":"pool.ntp.org","maxLength":63,"x-espos-restartRequired":true},"server1":{"title":"Second NTP server","description":"Optional fallback, used when the first does not answer.","type":"string","default":"","maxLength":63,"x-espos-restartRequired":true},"from_dhcp":{"title":"Use the NTP server DHCP offers","description":"Many routers hand out an NTP server with the lease, and it is usually the router itself вЂ” reachable even when the boat has no internet. A DHCP-supplied server replaces the list above and is refreshed on every new lease.","type":"boolean","default":true,"x-espos-restartRequired":true},"sk_fallback":{"title":"Fall back to the SignalK clock","description":"While the clock is unset, take the time from navigation.datetime on the SignalK stream. The server usually has GPS time, so a device with no internet route still gets a usable clock. Dropped as soon as NTP succeeds.","type":"boolean","default":true},"tz":{"title":"Timezone (POSIX TZ)","description":"For displays only вЂ” nothing espOS sends is ever in local time. POSIX form, e.g. UTC0, CET-1CEST,M3.5.0,M10.5.0/3 for central Europe. Note the POSIX sign convention: the offset is west-positive, so CET (UTC+1) is written -1.","type":"string","default":"UTC0","maxLength":39}},"additionalProperties":false,"description":"Where the device learns what time it is. Everything espOS publishes is UTC; the timezone below is for displays only."},"wifi":{"type":"object","title":"WiFi","x-espos-version":2,"properties":{"sta_enabled":{"title":"Station enabled","description":"Connect to the configured networks. Off = radio idle (portal still available if enabled).","type":"boolean","default":true},"hostname":{"title":"Hostname (moved to Network)","description":"Superseded by net.hostname. A value here is moved there at the next boot and this key is cleared; set the hostname under Network.","type":"string","default":"","maxLength":32,"pattern":"^[A-Za-z0-9-]*$","x-espos-restartRequired":true},"ssid0":{"title":"Network 1 SSID","type":"string","default":"","maxLength":32},"psk0":{"title":"Network 1 password","description":"Empty for an open network, else 8..63 characters (WPA).","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid0":{"title":"Network 1 BSSID pin","description":"Optional aa:bb:cc:dd:ee:ff to pin one access point (no roaming).","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid1":{"title":"Network 2 SSID","type":"string","default":"","maxLength":32},"psk1":{"title":"Network 2 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid1":{"title":"Network 2 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid2":{"title":"Network 3 SSID","type":"string","default":"","maxLength":32},"psk2":{"title":"Network 3 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid2":{"title":"Network 3 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid3":{"title":"Network 4 SSID","type":"string","default":"","maxLength":32},"psk3":{"title":"Network 4 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid3":{"title":"Network 4 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ip_mode":{"title":"Addressing","description":"dhcp = take an address from the router. static = use the address below; applied before every connection, so a change takes effect at the next (re)connect or reboot.","type":"string","default":"dhcp","maxLength":6,"enum":["dhcp","static"],"x-espos-restartRequired":true},"ip":{"title":"Static IP address","description":"IPv4 address for ip_mode = static. Invalid or empty falls back to DHCP with a warning in the log.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"netmask":{"title":"Static netmask","description":"e.g. 255.255.255.0. Required with a static address.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"gateway":{"title":"Static gateway","description":"Default router. Empty = none (the device then reaches its own subnet only).","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"dns0":{"title":"Static DNS 1","description":"Primary resolver with a static address. Empty = the gateway.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"dns1":{"title":"Static DNS 2","description":"Backup resolver with a static address. Empty = none.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"backoff_max_s":{"title":"Reconnect backoff cap","description":"Exponential backoff between rounds over all networks, 1 s doubling up to this cap, В±25 % jitter.","type":"integer","default":60,"minimum":5,"maximum":600,"x-espos-unit":"s"},"dhcp_tmo_s":{"title":"DHCP timeout","description":"Associated but no IP after this long counts as a failed attempt.","type":"integer","default":15,"minimum":3,"maximum":120,"x-espos-unit":"s"},"connect_tmo_s":{"title":"Connect timeout","description":"Safety net if the driver never reports a result.","type":"integer","default":20,"minimum":5,"maximum":120,"x-espos-unit":"s"},"fresh_assoc":{"title":"Fresh association at boot","description":"Drop the first WiFi association after each start once and join again, about 2 s per boot. Turn on when the device is unreachable for minutes after a power cut or crash: some access points (MikroTik RouterOS 7) keep the old connection and lose everything sent to the device until it times out.","type":"boolean","default":false},"stall_s":{"title":"Restart after no connection","description":"Restart the device once when WiFi has been trying this long without connecting, nothing else carries the network and nobody is on the setup access point. Once per outage: not again until it has connected. 0 = never; at least 300.","type":"integer","default":1800,"minimum":0,"maximum":86400,"x-espos-unit":"s"},"portal_enabled":{"title":"Provisioning access point","description":"Bring up the setup access point when no network is configured or nothing connects for a while.","type":"boolean","default":true},"portal_after_s":{"title":"Portal after","description":"Seconds without a connection before the access point comes up (0 networks configured: immediately).","type":"integer","default":90,"minimum":10,"maximum":3600,"x-espos-unit":"s"},"portal_online":{"title":"Access point while online","description":"Raise the setup access point even when Ethernet (or another transport) is carrying the network. Off: a device reachable over Ethernet does not advertise one.","type":"boolean","default":false},"portal_ssid":{"title":"Access point SSID","description":"Empty = espOS-<last 4 hex of the device MAC>.","type":"string","default":"","maxLength":32},"portal_psk":{"title":"Access point password","description":"Empty = open network. 8..63 characters for WPA2.","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"ps_mode":{"title":"Power save","description":"WiFi modem power save. 'none' keeps latency lowest. A build with 802.15.4 coexistence (Zigbee, Thread) runs 'none' as 'min'.","type":"string","default":"none","maxLength":4,"enum":["none","min","max"],"x-espos-restartRequired":true}},"additionalProperties":false,"description":"Station networks in priority order (slot 0 first), addressing, reconnect policy and the provisioning access point."}},"additionalProperties":false}␀␀␀␀ґn@|Ы@␀␀␀А•@␀␀␀ЊЫ@8ё@`Ь@␀␀␀и”@␀␀␀lЬ@Њґ@¤Ь@␀␀␀ ”@␀␀␀¬Ь@4–@шЬ@␀␀␀’@	␀␀␀Э@|n@xЭ@␀␀␀hђ@␀␀␀ЂЭ@™@шЭ@␀␀␀°‡@␀␀␀␀Ю@X@tЮ@„Ю@Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀d@аЮ@ьЮ@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀дћ@ЂЯ@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Дћ@ђЯ@¤Я@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¤ћ@ЬЯ@рЯ@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀мћ@4а@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Мћ@Dа@Ь@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¬ћ@Xа@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀фћ@lа@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Фћ@|а@Ь@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ґћ@ђа@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ьћ@¤а@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ьћ@ґа@Ь@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀јћ@Иа@Ь@Ь@␀␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀„¦@Ьа@иа@Ь@␀␀␀␀␀␀ђб@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¤–@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ё@б@¬б@Ь@␀␀␀␀␀␀Ь@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀